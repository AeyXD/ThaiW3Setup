{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thaiw3setup-report",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "r2_buckets": [{ "binding": "REPORTS", "bucket_name": "thaiw3setup-reports" }],
  "ratelimits": [
    {
      "name": "REPORT_LIMITER",
      "namespace_id": "3001",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  // macOS reports are posted as comments here while the Mac build is being tested
  "vars": { "ISSUE_REPO": "FordenHillson/ThaiW3Setup", "ISSUE_NUMBER": "6" }
  // secret ADMIN_PASSWORD: wrangler secret put ADMIN_PASSWORD (local dev: .dev.vars)
  // secret GITHUB_TOKEN: fine-grained token for this repo with Issues read/write; unset means no forwarding
}
